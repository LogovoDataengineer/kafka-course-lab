{
  "uid": "kafka-course",
  "title": "Kafka: курс",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Lag групп (сообщений)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (consumergroup) (kafka_consumergroup_lag{consumergroup=~\"$group\"})",
          "legendFormat": "{{consumergroup}}{{topic}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Скорость записи в топики (сообщений в секунду)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (topic) (rate(kafka_topic_partition_current_offset{topic=~\"$topic\"}[1m]))",
          "legendFormat": "{{consumergroup}}{{topic}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Скорость чтения групп (сообщений в секунду)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (consumergroup) (rate(kafka_consumergroup_current_offset_sum{consumergroup=~\"$group\"}[1m]))",
          "legendFormat": "{{consumergroup}}{{topic}}"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "group",
        "label": "Группа",
        "type": "custom",
        "query": "metrics-app",
        "current": {
          "text": "metrics-app",
          "value": "metrics-app"
        },
        "options": [
          {
            "text": "metrics-app",
            "value": "metrics-app",
            "selected": true
          }
        ]
      },
      {
        "name": "topic",
        "label": "Топик",
        "type": "custom",
        "query": "metrics-demo",
        "current": {
          "text": "metrics-demo",
          "value": "metrics-demo"
        },
        "options": [
          {
            "text": "metrics-demo",
            "value": "metrics-demo",
            "selected": true
          }
        ]
      }
    ]
  }
}
